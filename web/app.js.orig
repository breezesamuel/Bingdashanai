$('#agStopGo') && ($('#agStopGo').onclick = async () => {
  const agentId = $('#agStopId').value.trim();
  if (!agentId) return toast('请填写 Agent ID', 'bad');
  const d = await api('/v1/agentcenter/agents/stop', { method: 'POST', body: JSON.stringify({ agentId }) });
