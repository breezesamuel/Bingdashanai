$('#agLogsGo') && ($('#agLogsGo').onclick = async () => {
  const agentId = $('#agLogsId').value.trim();
  if (!agentId) return toast('请填写 Agent ID', 'bad');
  const d = await api('/v1/agentcenter/agents/logs', { method: 'POST', body: JSON.stringify({ agentId }) });
